# 复制为 .env 后按需修改；已被真实环境变量覆盖的项不会被 .env 改写。
# 生产环境建议由 systemd EnvironmentFile 注入，不依赖本文件。
NODE_ENV=development
PORT=4000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_DATABASE=jianli

# 必填：至少 16 个字符；与旧 Node 服务保持一致才能复用现有登录态
JWT_SECRET=change-me-at-least-16-chars
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=5242880

# 可选：启动时创建/重置管理员
# ADMIN_INITIAL_PASSWORD=

# 可选：Next 按需刷新（缺一个即关闭）
# NEXT_REVALIDATE_URL=http://localhost:3000
# REVALIDATE_SECRET=
