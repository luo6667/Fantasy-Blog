# ============ 服务配置 ============
# 服务监听端口
PORT=4000

# ============ 数据库 ============
# MongoDB 连接串（本地或 Atlas）
MONGODB_URI=mongodb://127.0.0.1:27017/blog

# ============ JWT 鉴权 ============
# JWT 签名密钥：生产环境务必替换为强随机值（如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string
# Token 过期时间（jsonwebtoken 支持 7d / 12h / 60m 等格式）
JWT_EXPIRES_IN=7d

# ============ 跨域 ============
# 允许访问 API 的前端来源（逗号分隔多个）
CORS_ORIGIN=http://localhost:5173

# ============ 文件上传 ============
# 图片上传存储目录（相对项目根目录）
UPLOAD_DIR=uploads
# 单个文件大小上限（字节，默认 5MB）
UPLOAD_MAX_SIZE=5242880
