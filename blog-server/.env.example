# ============ 服务配置 ============
# 服务监听端口
PORT=4000

# ============ 数据库（MySQL） ============
# 主机 / 端口
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 账号 / 密码
MYSQL_USER=root
MYSQL_PASSWORD=1234
# 数据库名（不存在时启动会自动创建）
MYSQL_DATABASE=jianli

# ============ 旧数据迁移（可选） ============
# 仅 scripts/migrate-mongodb-to-mysql.ts 读取旧 MongoDB 数据时使用，正常运行不需要
# MONGODB_URI=mongodb://127.0.0.1:27017/blog

# ============ JWT 鉴权 ============
# JWT 签名密钥：生产环境务必替换为强随机值（如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string
# Token 过期时间（jsonwebtoken 支持 7d / 12h / 60m 等格式）
JWT_EXPIRES_IN=7d

# ============ 跨域 ============
# 允许访问 API 的前端来源（逗号分隔多个）
CORS_ORIGIN=http://localhost:5173

# ============ 文件上传 ============
# 图片上传存储目录（相对项目根目录）
UPLOAD_DIR=uploads
# 单个文件大小上限（字节，默认 5MB）
UPLOAD_MAX_SIZE=5242880

# ============ 管理员初始化 ============
# 可选：npm run seed 创建/重置管理员账号 admin 时使用的初始密码（至少 8 位）。
# 不设置则 seed 创建 admin 时随机生成并打印；已存在的 admin 不会被重置。
ADMIN_INITIAL_PASSWORD=
