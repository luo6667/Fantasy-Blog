# blog 站点 Nginx 参考配置（宝塔用户：把「网站 → 配置文件」里自动生成的
# location / 段整段替换成本文件里的 location / 段；证书路径用宝塔申请的即可）
#
# 要点：
#   1. 整站反代到 Next.js 的 3000 端口即可 —— /api 与 /uploads 由 next.config.ts
#      的 rewrites 内部转发到 4000，Nginx 不需要按路径分发；
#   2. proxy_buffering off：AI 对话是 SSE 流式输出，被缓冲会变成「一次性吐完」或卡住；
#   3. 4000 端口不要对外开放，只允许 127.0.0.1。

server {
    listen 80;
    listen [::]:80;
    server_name www.jasonluoblog.online jasonluoblog.online;

    # 宝塔申请 Let's Encrypt 后会自动加上 301 到 https，这里保持默认即可
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.jasonluoblog.online jasonluoblog.online;

    # 证书路径按宝塔实际生成的填写
    ssl_certificate     /www/server/panel/vhost/cert/jasonluoblog.online/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/jasonluoblog.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # 文章里上传的图片上限是 5MB（UPLOAD_MAX_SIZE），这里留出富余
    client_max_body_size 10m;

    access_log /www/wwwlogs/jasonluoblog.online.log;
    error_log  /www/wwwlogs/jasonluoblog.online.error.log;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE（AI 流式对话）不能被缓冲
        proxy_buffering off;
        proxy_read_timeout 120s;

        # 保持到上游的长连接；注意不要写 $connection_upgrade（需要额外 map，宝塔里容易漏）
        proxy_set_header Connection "";
    }

    # 静态资源长缓存：Next 产物带内容哈希，可安全缓存一年
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
